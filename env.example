# Entorno Local
APP_DEV=true

# Comportamiento del pipeline
ENABLE_MUSIC_RENDER=true
ENABLE_AI_BACKGROUND=true

# Meta
INSTAGRAM_ID=your_instagram_business_account_id
INSTAGRAM_TOKEN=your_instagram_access_token

# IA
GEMINI_API_KEY=your_gemini_api_key
AI_TEXT_MODEL=gemini-2.5-flash
AI_IMAGE_MODEL=imagen-4.0-generate-001

# Personalización de contenido (texto)
CONTENT_LANGUAGE=Spanish
CONTENT_AUDIENCE=parents of young children
CONTENT_TOPIC=child language development
CONTENT_TONE=warm, practical, and encouraging

# Overrides opcionales de texto final (si se definen, reemplazan salida IA)
CUSTOM_MAIN_TEXT=
CUSTOM_EMPHASIS_TEXT=

# Prompt completo opcional para generación de texto (reemplaza prompt por defecto)
AI_TEXT_PROMPT=

# Fallbacks opcionales cuando falle IA
AI_FALLBACK_MAIN=
AI_FALLBACK_EMPHASIS=

# Prompt(s) de imagen IA
# Usa uno solo:
AI_BG_PROMPT=
# O varios separados por ||
AI_BG_PROMPTS=

# Almacenamiento (Para subir la foto temporalmente)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
ENABLE_INSTAGRAM_POSTING=false
JAMENDO_CLIENT_ID=your_jamendo_client_id

# Keywords de música (coma separadas)
JAMENDO_KEYWORDS=children,happy kids,playful,happy ukulele